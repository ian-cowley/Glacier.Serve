  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Glacier.Serve\Glacier.Serve.csproj" />
  </ItemGroup>
</Project>
