<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Serve</PackageId>
    <Version>1.9.0</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Ultra-low-latency, Native AOT web and LLM inference microservices engine for .NET 10. Features PagedAttention, Continuous Iteration Batching, SIMD HTTP delimiter scanning, zero-allocation Radix Tree routing, Glacier.Storage Arrow streaming, direct Polaris/Tensor streaming, and Autonomous Sleep Consolidation Daemons.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Serve</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Serve.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>http;web;api;vllm;ollama;paged-attention;continuous-batching;llm;inference;simd;radix-tree;arrow-ipc;storage;net10;aot;glacier;continual-learning;sleep</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.9.0: TLS termination, constant-time Bearer auth, connection admission cap (503), Slowloris header timeout (408), chunked SSE helpers, and aligned ecosystem deps.</PackageReleaseNotes>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Serve.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj" />
    <ProjectReference Include="../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj" />
    <ProjectReference Include="../../../Glacier.Tensor/src/Glacier.Tensor/Glacier.Tensor.csproj" Condition="Exists('../../../Glacier.Tensor/src/Glacier.Tensor/Glacier.Tensor.csproj')" />
    <ProjectReference Include="../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj" />
    <ProjectReference Include="../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj" Condition="Exists('../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj')" />
    <ProjectReference Include="../../../Glacier.Tune/src/Glacier.Tune/Glacier.Tune.csproj" Condition="Exists('../../../Glacier.Tune/src/Glacier.Tune/Glacier.Tune.csproj')" />
    <ProjectReference Include="../../../Glacier.MemEx/src/Glacier.MemEx/Glacier.MemEx.csproj" Condition="Exists('../../../Glacier.MemEx/src/Glacier.MemEx/Glacier.MemEx.csproj')" />
    <ProjectReference Include="../../../Glacier.Agent/src/Glacier.Agent/Glacier.Agent.csproj" Condition="Exists('../../../Glacier.Agent/src/Glacier.Agent/Glacier.Agent.csproj')" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Formats" Version="1.0.1" />
    <PackageReference Include="Glacier.Polaris" Version="1.2.6" />
    <PackageReference Include="Glacier.Tensor" Version="1.1.2" />
    <PackageReference Include="Glacier.Inference" Version="1.10.1" />
    <PackageReference Include="Glacier.Rag" Version="1.4.3" />
    <PackageReference Include="Glacier.Tune" Version="1.7.0" />
    <PackageReference Include="Glacier.MemEx" Version="1.2.3" />
    <PackageReference Include="Glacier.Agent" Version="1.5.3" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') and '$(UseLocalProjectReferences)' != 'false' and !Exists('../../../Glacier.Tensor/src/Glacier.Tensor/Glacier.Tensor.csproj')">
    <PackageReference Include="Glacier.Tensor" Version="1.1.2" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') and '$(UseLocalProjectReferences)' != 'false' and !Exists('../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj')">
    <PackageReference Include="Glacier.Rag" Version="1.4.3" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') and '$(UseLocalProjectReferences)' != 'false' and !Exists('../../../Glacier.MemEx/src/Glacier.MemEx/Glacier.MemEx.csproj')">
    <PackageReference Include="Glacier.MemEx" Version="1.2.3" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../../Glacier.Formats/src/Glacier.Formats/Glacier.Formats.csproj') and '$(UseLocalProjectReferences)' != 'false' and !Exists('../../../Glacier.Agent/src/Glacier.Agent/Glacier.Agent.csproj')">
    <PackageReference Include="Glacier.Agent" Version="1.5.3" />
  </ItemGroup>
</Project>
